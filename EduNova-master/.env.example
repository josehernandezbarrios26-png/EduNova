# Plantilla de Variables de Entorno - Proyecto EduNova
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=True
# Hosts permitidos para ejecución local y LAN privada. La IP de red se detecta automáticamente.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Credenciales de Base de Datos MySQL
DB_NAME=sinetec_db
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=3306

# Configuración de Correo Electrónico
# Desarrollo: usar console (imprime en terminal, no envía realmente)
# Producción: usar smtp con cuenta Gmail o servidor institucional
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password_gmail
DEFAULT_FROM_EMAIL=SINETEC <noreply@sinetec.edu.co>
